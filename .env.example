# PostgreSQL: works with local Docker, Neon, or your own PostgreSQL host
DATABASE_URL="postgresql://project:change-me@localhost:5432/project_management?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-32-byte-secret"
# Optional S3 compatible object storage (e.g. ParsPack, MinIO, AWS)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Set to true only for a disposable local development database
ALLOW_DEMO_SEED="false"

# Optional paid services: leave blank until you obtain a provider.
EMAIL_GATEWAY_URL=
EMAIL_GATEWAY_TOKEN=
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# Free Vercel Cron can run the daily reminder route. Set a random 32+ byte secret.
CRON_SECRET=
# HTTP adapters expect POST JSON {to, subject, message} + Authorization: Bearer <TOKEN>
