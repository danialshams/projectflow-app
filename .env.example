# PostgreSQL: works with local Docker, Neon, or your own PostgreSQL host
DATABASE_URL="postgresql://project:change-me@localhost:5432/project_management?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-32-byte-secret"
# Optional S3 compatible object storage (e.g. ParsPack, MinIO, AWS)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Set to true only for a disposable local development database
ALLOW_DEMO_SEED="false"
